# Generate separate random values; never commit the real .env file.
SENTINELOPS_API_TOKEN=replace-with-a-long-random-token
SENTINELOPS_AUDIT_KEY=replace-with-an-independent-random-hmac-key

# Opt in only on a network path restricted to the metrics scraper.
SENTINELOPS_METRICS_ENABLED=0

# Process-local API edge controls. Use exact hosts/origins; wildcards are rejected.
SENTINELOPS_MAX_REQUEST_BYTES=1000000
SENTINELOPS_RATE_LIMIT_RPM=60
SENTINELOPS_MAX_INFLIGHT=16
SENTINELOPS_TRUSTED_HOSTS=127.0.0.1,localhost
SENTINELOPS_CORS_ORIGINS=

# Keep single as the conservative default; auto enables cost-aware per-incident routing.
SENTINELOPS_ORCHESTRATION_MODE=single

# Keep fixture mode unless you intentionally connect read-only observability providers.
SENTINELOPS_EVIDENCE_MODE=fixture
SENTINELOPS_ALLOWED_OBSERVABILITY_HOSTS=prometheus.internal,loki.internal,tempo.internal
SENTINELOPS_PROMETHEUS_URL=https://prometheus.internal
SENTINELOPS_LOKI_URL=https://loki.internal
SENTINELOPS_TEMPO_URL=https://tempo.internal
SENTINELOPS_PROMETHEUS_TOKEN=replace-with-read-only-token
SENTINELOPS_LOKI_TOKEN=replace-with-read-only-token
SENTINELOPS_TEMPO_TOKEN=replace-with-read-only-token
SENTINELOPS_OBSERVABILITY_TENANT=replace-with-tenant-id
